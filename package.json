{
  "name": "ai-mission-manager",
  "version": "1.0.0",
  "private": true,
  "description": "AI Mission Manager desktop app",
  "homepage": "https://github.com/pierophp/ai-mission-manager-electrobun#readme",
  "bugs": {
    "url": "https://github.com/pierophp/ai-mission-manager-electrobun/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierophp/ai-mission-manager-electrobun.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "start": "bunx electrobun run",
    "build": "bun scripts/build-resources.mjs && vp build && bunx electrobun build",
    "check": "bun scripts/build-resources.mjs && vp check --no-fmt src && vp check src/bun src/renderer/runtime/desktop-api.ts src/shared/electrobun-rpc.ts src/renderer/global.d.ts src/renderer/main.tsx vite.config.ts package.json README.md tsconfig.json electrobun.config.ts hutch.config.ts scripts && tsc --noEmit",
    "test": "bun scripts/build-resources.mjs && bun test scripts/check-pstack-vendor.test.mjs && bun scripts/check-pstack-vendor.mjs && bun --bun vp test && tsc --noEmit",
    "postinstall": "electrobun prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "electrobun": "^2.0.2",
    "embla-carousel-react": "^8.6.0",
    "immer": "^11.1.18",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.1",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  }
}
